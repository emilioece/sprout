#:import hex_color kivy.utils.get_color_from_hex
#:import theme theme.theme
#:import EMOJI_FONT components.utils.EMOJI_FONT

# ===========================================================================
# Reusable Styled Custom Widgets
# ===========================================================================

<RoundedBox>:
    canvas.before:
        Color:
            rgba: self.border_color
        RoundedRectangle:
            pos: self.x - self.border_width, self.y - self.border_width
            size: self.width + self.border_width * 2, self.height + self.border_width * 2
            radius: [self.radius]
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]

<PillButton>:
    background_normal: ""
    background_down: ""
    background_color: [0, 0, 0, 0]
    color: self.fg_color
    bold: True
    font_size: "13sp"
    canvas.before:
        Color:
            rgba: self.bg_color if self.state == "normal" else (self.bg_color[0]*0.9, self.bg_color[1]*0.9, self.bg_color[2]*0.9, self.bg_color[3])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]

<IconButton@PillButton>:
    size_hint: None, None
    size: dp(40), dp(40)

<IconButtonRow>:
    padding: dp(14), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: self.bg_color if self.state == "normal" else (self.bg_color[0]*0.92, self.bg_color[1]*0.92, self.bg_color[2]*0.92, self.bg_color[3])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
    EmojiLabel:
        text: root.icon
        font_size: "16sp"
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"center_y": 0.5}
    Label:
        text: root.label_text
        color: root.fg_color
        bold: True
        font_size: "13sp"
        halign: "left"
        valign: "middle"
        text_size: self.size

<SideNavItem>:
    size_hint_y: None
    height: dp(46)
    padding: [dp(12), 0]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    EmojiLabel:
        text: root.icon
        font_size: "16sp"
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"center_y": 0.5}
    Label:
        text: root.text
        color: root.fg_color
        bold: True
        font_size: "13sp"
        halign: "left"
        valign: "middle"
        text_size: self.size

# ===========================================================================
# Stat Card Component
# ===========================================================================

<StatCard>:
    orientation: "vertical"
    padding: dp(18)
    size_hint_y: None
    height: dp(120)
    bg_color: theme.surface
    border_color: theme.border
    radius: dp(16)

    EmojiLabel:
        text: root.icon
        font_size: "20sp"
        size_hint: None, None
        size: dp(28), dp(28)
        color: theme.text

    Widget:

    Label:
        text: root.value
        font_size: "24sp"
        bold: True
        color: theme.dark_green
        size_hint_y: None
        height: dp(30)
        halign: "left"
        text_size: self.size

    Label:
        text: root.label_text
        font_size: "11sp"
        bold: True
        color: theme.muted
        size_hint_y: None
        height: dp(16)
        halign: "left"
        text_size: self.size

# ===========================================================================
# Plant Row Widget (Used in Dashboard & My Plants lists)
# ===========================================================================

<PlantRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(72)
    padding: dp(14)
    spacing: dp(12)
    bg_color: theme.surface
    border_color: theme.border
    radius: dp(16)

    # Initial avatar circle
    BoxLayout:
        size_hint_x: None
        width: dp(44)
        canvas.before:
            Color:
                rgba: theme.accent_soft
            Ellipse:
                pos: self.pos
                size: self.size
        Label:
            text: root.initials
            bold: True
            color: theme.dark_green
            font_size: "12sp"

    # Plant name and details label stack
    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.plant_name
            bold: True
            color: theme.text
            font_size: "14sp"
            halign: "left"
            valign: "bottom"
            text_size: self.size
        Label:
            text: root.subtitle
            color: theme.muted
            font_size: "11sp"
            halign: "left"
            valign: "top"
            text_size: self.size

    # Water button trigger
    IconButton:
        text: "\U0001F4A7"
        bg_color: theme.water_highlight
        fg_color: hex_color("#1A73E8") if not theme.dark else hex_color("#60A5FA")
        radius: dp(12)
        on_release: root.on_water()

    # Due status label (e.g. "In 3d")
    Label:
        text: root.due_label
        size_hint_x: None
        width: dp(70)
        color: theme.muted
        font_size: "11sp"
        halign: "right"
        valign: "middle"
        text_size: self.size

    # Delete button trigger
    IconButton:
        text: "\U0001F5D1"
        bg_color: [0, 0, 0, 0]
        fg_color: theme.hint
        size: dp(34), dp(34)
        radius: dp(10)
        on_release: root.on_delete()

# ===========================================================================
# Symptom Item Card (Used in Symptom Guide)
# ===========================================================================

<SymptomRow>:
    size_hint_y: None
    height: dp(72)
    padding: dp(16)
    spacing: dp(14)
    bg_color: theme.surface
    border_color: theme.border
    radius: dp(16)

    EmojiLabel:
        text: root.icon
        font_size: "24sp"
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}

    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.title
            bold: True
            font_size: "14sp"
            color: theme.text
            halign: "left"
            valign: "bottom"
            text_size: self.size
        Label:
            text: root.subtitle
            font_size: "11sp"
            color: theme.muted
            halign: "left"
            valign: "top"
            text_size: self.size

    # Urgency pill badge on the right
    Label:
        text: root.urgency_text
        font_size: "11sp"
        bold: True
        color: root.urgency_color
        size_hint_x: None
        width: dp(120)
        halign: "center"
        valign: "middle"
        canvas.before:
            Color:
                rgba: root.urgency_bg
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12)]

# ===========================================================================
# Main Application Root Layout
# ===========================================================================

<RootLayout>:
    orientation: "horizontal"
    canvas.before:
        Color:
            rgba: theme.bg
        Rectangle:
            pos: self.pos
            size: self.size

    # Left Sidebar Navigation Container
    BoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: dp(240)
        padding: dp(16)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: theme.surface
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: theme.border
            Line:
                points: [self.right, self.y, self.right, self.top]
                width: 1

        # App Logo & Title Header
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(64)
            padding: [dp(6), 0]
            BoxLayout:
                size_hint_y: None
                height: dp(30)
                spacing: dp(6)
                EmojiLabel:
                    text: "\U0001F331"
                    font_size: "20sp"
                    size_hint: None, None
                    size: dp(26), dp(26)
                    pos_hint: {"center_y": 0.5}
                Label:
                    text: "Sprout"
                    bold: True
                    font_size: "20sp"
                    color: theme.text
                    halign: "left"
                    text_size: self.size
            Label:
                text: root.plant_count_label
                font_size: "11sp"
                color: theme.muted
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: dp(18)

        # Navigation Links
        SideNavItem:
            id: nav_dashboard
            icon: "\U0001F3E1"
            text: "Dashboard"
            on_touch_down: if self.collide_point(*args[1].pos): app.switch_tab("dashboard")

        SideNavItem:
            id: nav_plants
            icon: "\U0001FAB4"
            text: "My Plants"
            on_touch_down: if self.collide_point(*args[1].pos): app.switch_tab("plants")

        SideNavItem:
            id: nav_schedule
            icon: "\U0001F4C5"
            text: "Schedule"
            on_touch_down: if self.collide_point(*args[1].pos): app.switch_tab("schedule")

        SideNavItem:
            id: nav_symptoms
            icon: "\U0001F50D"
            text: "Symptom Guide"
            on_touch_down: if self.collide_point(*args[1].pos): app.switch_tab("symptoms")

        Widget:

        # Dark Mode Toggle Button
        SideNavItem:
            icon: "\U0001F319" if not theme.dark else "\u2600\uFE0F"
            text: app.dark_mode_label
            on_touch_down: if self.collide_point(*args[1].pos): app.toggle_dark_mode()

        # Tip Box at bottom of sidebar
        RoundedBox:
            orientation: "vertical"
            size_hint_y: None
            height: dp(84)
            padding: dp(12)
            bg_color: theme.accent_soft
            border_color: theme.accent_soft
            radius: dp(16)
            BoxLayout:
                size_hint_y: None
                height: dp(18)
                spacing: dp(4)
                EmojiLabel:
                    text: "\U0001F4A1"
                    font_size: "12sp"
                    size_hint: None, None
                    size: dp(18), dp(18)
                    pos_hint: {"center_y": 0.5}
                Label:
                    text: "Tip for beginners"
                    bold: True
                    font_size: "11sp"
                    color: theme.dark_green
                    halign: "left"
                    text_size: self.size
            Label:
                text: "Check the Dashboard daily -- it shows exactly what needs attention today."
                font_size: "10sp"
                color: theme.muted2
                halign: "left"
                valign: "top"
                text_size: self.size

        # Main Add Plant Action Button
        PillButton:
            text: "+  Add Plant"
            size_hint_y: None
            height: dp(48)
            bg_color: theme.dark_green
            fg_color: [1, 1, 1, 1]
            radius: dp(14)
            on_release: app.open_add_modal()

    # Main Scrollable Content Window
    ScrollView:
        do_scroll_x: False
        BoxLayout:
            id: main_content
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: dp(48)
            spacing: dp(24)